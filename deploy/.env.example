# deploy/.env — copy to deploy/.env and fill in the blanks. deploy/.env is
# gitignored; deploy/deploy.sh copies it to the VM (mode 600) and passes it to
# docker compose (--env-file) and to the app/worker containers (env_file).
#
# Keep comments on their own lines. Wrap values containing spaces, '#' or '$'
# in single quotes (compose interpolates an unquoted '$' in env_file values).

# ---- Public hostnames (sslip.io until there is a real domain) ----------------
# Caddy serves HTTPS/WSS on both; each gets its own Let's Encrypt certificate.
SITE_HOST_V4=146-235-229-232.sslip.io
SITE_HOST_V6=2603-c024-c020-3700-0-537e-9221-8587.sslip.io
# Whose certificate mosquitto presents on :8883. Must be the name the ESP32
# dials for MQTT (its LTE carrier is IPv6-only; via NAT64 it can still reach
# the IPv4 name). Set to SITE_HOST_V6's value if the device dials that instead.
MQTT_TLS_HOST=146-235-229-232.sslip.io

# ---- Gemini ------------------------------------------------------------------
# Required: app/gemini_config.py raises at import without it.
GOOGLE_API_KEY=
# Optional: app/agents/gemini_client.py prefers this, falls back to GOOGLE_API_KEY.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
# app/agents/openai_client.py: gemini (default) or azure_openai.
# AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY are only needed for azure_openai.
LLM_PROVIDER=gemini

# ---- Postgres (the compose `postgres` service; also initialises it) ----------
# DB_HOST is the compose service name. DB_NAME/DB_USER/DB_PASSWORD are used
# both by the app/worker and to create the database on first start.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aipin
DB_USER=aipin
DB_PASSWORD=

# ---- Speech models (paths inside the app container; ./data is mounted at /data)
VOSK_MODEL_PATH=/data/vosk-model-small-en-us-0.15
PIPER_MODEL_PATH=/data/piper_voices/en_US-amy-medium.onnx

# ---- Developer WebSocket tuning (production value carried over from Azure) ---
DEVELOPER_WS_END_SILENCE_SEC=1.0
# DEVELOPER_WS_SILERO_STOP_SECS (0.8 on Azure) is not read by anything under
# app/ today, so it is deliberately not set here.

# ---- Worker (listener/worker.py) ----------------------------------------------
WORKER_POLL_INTERVAL_SEC=2
LOG_LEVEL=INFO

# ---- MQTT (shared by the mosquitto service, the worker and the ESP32) --------
# Worker -> broker. The worker dials the plaintext listener on 1883, which is
# NOT published in docker-compose.yml (reachable only inside the compose
# network; see deploy/mosquitto/mosquitto.conf). 8883 is the device-facing TLS
# port: its certificate is issued for MQTT_TLS_HOST, so `mosquitto:8883` only
# works with the hostname check skipped (MQTT_TLS_INSECURE below).
MQTT_HOST=mosquitto
MQTT_PORT=1883
# TLS to the broker: empty = auto (on, except on port 1883); 1/0 forces it.
MQTT_TLS=
# Skip only the certificate hostname check (the chain is still verified):
# empty = auto (skipped when MQTT_HOST differs from MQTT_TLS_HOST); 1/0 forces it.
MQTT_TLS_INSECURE=
# Backend/worker credentials (full topic access).
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Path to a CA / fullchain PEM inside the worker container, or empty to use the
# system CA store (Let's Encrypt is publicly trusted, so empty is fine). Only
# used when TLS is on.
MQTT_CA_CERT=
# Device credentials (restricted to MQTT_COMMAND_TOPIC_PREFIX/DEVICE_ID/#).
MQTT_DEVICE_USERNAME=esp32s3
MQTT_DEVICE_PASSWORD=
# Command topic is {MQTT_COMMAND_TOPIC_PREFIX}/{DEVICE_ID}/cmd (retained, QoS 1).
MQTT_COMMAND_TOPIC_PREFIX=aipin
DEVICE_ID=esp32s3
