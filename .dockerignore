# Only app/, listener/, agent_directory/, deploy/sql/ and requirements.txt go into the image.
.git
.gitignore
.gitattributes
.claude
.vscode
.idea

# Secrets / deploy-time artifacts (mounted at runtime, never baked in);
# deploy/sql is the one exception (schema the worker applies at startup).
.env
deploy
!deploy/sql
data
vosk-model-*
piper_voices

# Not part of the backend
mobile_app
test
scripts
python_test
*.md
*.zip
*.sh
azure-deploy.sh
test-docker.sh
pyrightconfig.json

# Python / OS noise (patterns are anchored to the context root, hence **/)
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
.coverage
htmlcov
venv
.venv
env
.DS_Store
*.log
