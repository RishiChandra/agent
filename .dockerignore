# Allow only inputs used by the backend image.
**
!Dockerfile
!requirements.txt
!requirements-oci.lock
!app/
!app/**
!agent_directory/
!agent_directory/**
!listener/
!listener/*.py
!deploy/
!deploy/app_backend/
!deploy/app_backend/*.py
# Exclusions below override allowed source directories.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sql
**/*.dump
**/*.log
**/__pycache__/
**/*.pyc
**/.git/
**/data/
**/*.onnx
**/node_modules/
